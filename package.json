{
  "name": "elil-jewellery-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack MERN e-commerce application for a premium jewellery brand.",
 
  "scripts": {
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saleemahmh/Elil-Jewellery-Ecommerce.git"
  },
  "keywords": [ "mern",
    "react",
    "express",
    "mongodb",
    "nodejs",
    "tailwindcss",
    "ecommerce",
    "jewellery"
  ],
  "author": "Saleemah",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Saleemahmh/Elil-Jewellery-Ecommerce/issues"
  },
  "homepage": "https://github.com/Saleemahmh/Elil-Jewellery-Ecommerce#readme",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
